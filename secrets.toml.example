# Bu dosyanın adını "secrets.toml" yapıp Streamlit Cloud'daki
# App -> Settings -> Secrets kısmına aynı içeriği yapıştıracaksınız.
# ASLA gerçek secrets.toml dosyasını GitHub'a YÜKLEMEYİN.
#
# ÖNEMLİ: Bu, "Arama Takip Sistemi"nden TAMAMEN BAĞIMSIZ ikinci bir uygulamadır.
# Kendine ait AYRI bir Google E-Tablo ve (istenirse) ayrı bir servis hesabı kullanmalıdır,
# aksi halde iki uygulamanın verileri karışır.

admin_password = "BURAYA_GUCLU_BIR_SIFRE"
sheet_id = "DURU_TAKIP_ICIN_AYRI_GOOGLE_SHEET_ID"

[gcp_service_account]
type = "service_account"
project_id = "PROJE_ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxxx@xxxx.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
